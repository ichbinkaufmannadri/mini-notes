# Copy to .env.local and fill in. Never commit .env.local.
# Public values (safe in the browser because RLS protects the data):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only: where Supabase sends users back after GitHub login.
SITE_URL=http://localhost:3000

# NOTE: the Supabase SECRET key does NOT go here. It belongs only to the Render worker.
